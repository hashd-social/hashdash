# API URL
REACT_APP_API_URL=http://localhost:3002
REACT_APP_VAULT_API_URL=http://localhost:3004

# Network Configuration
REACT_APP_CHAIN_ID=31337
REACT_APP_RPC_URL=http://localhost:8545

# ByteCave P2P Configuration
# Direct node addresses for WebRTC connections (no relay needed)
# Example: bat-alpha (port 4000), bat-beta (port 4001), bat-gamma (port 4003)
REACT_APP_DIRECT_NODE_ADDRS=/ip4/127.0.0.1/tcp/4000/ws/p2p/12D3KooWDfTdWP39bCi2jzDXhjib9bC1zMnNPBuAL6mejhoKqqYM,/ip4/127.0.0.1/tcp/4001/ws/p2p/12D3KooWHrfiYQFAiURrADVmjjGEMRqXNjApd1nfaNvAPEJCj6Vz,/ip4/127.0.0.1/tcp/4003/ws/p2p/12D3KooWQjgWKGvKGui6JForBCU51cMXLkpUwCMNuatVL9NyRhL2
# Relay peers for circuit relay fallback (NAT traversal)
REACT_APP_RELAY_PEERS=/ip4/127.0.0.1/tcp/4002/ws/p2p/12D3KooWDUsTtqKh7VcnydpAe5G8SwiMKYramFny6caML58zbg9Y
REACT_APP_RELAY_HTTP_URL=http://localhost:9090

